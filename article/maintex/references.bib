  file = {/Users/doki/Zotero/storage/P2ER7PS5/Hunsaker et al. - 2008 - Evaluating the Temporal Context of Episodic Memory The Role of CA3 and CA1.pdf}
}

@article{ito2012,
  title = {Functional Division of Hippocampal Area {{CA1}} via Modulatory Gating of Entorhinal Cortical Inputs},
  author = {Ito, Hiroshi T. and Schuman, Erin M.},
  year = 2012,
  journal = {Hippocampus},
